{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "src/engine.ts",
    "src/council.ts",
    "src/providers.ts",
    "server/**/*.ts",
    "api/**/*.ts"
  ]
}
